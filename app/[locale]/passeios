function getLocalizedPath(
  locale: Locale,
  path: string,
) {
  if (locale === defaultLocale) {
    return path
  }

  return `/${locale}${path}`
}

function getTourValue(
  tour: TourLike,
  keys: string[],
) {
  for (const key of keys) {
    const value = tour[key]

    if (
      value !== undefined &&
      value !== null &&
      value !== ''
    ) {
      return value
    }
  }

  return undefined
}

function getTourImage(tour: TourLike) {
  const image = getTourValue(tour, [
    'image',
    'imageUrl',
    'photo',
    'photoUrl',
  ])

  if (!image) {
    return asset('/images/hero-lencois.jpg')
  }

  return asset(String(image))
}

function getTourDescription(
  tour: TourLike,
  translation: TranslationLike,
) {
  return (
    translation.description ||
    getTourValue(tour, [
      'description',
      'fullDescription',
      'details',
      'content',
    ]) ||
    translation.shortDescription ||
    getTourValue(tour, [
      'shortDescription',
      'summary',
    ]) ||
    ''
  )
}

function getTourTitle(
  tour: TourLike,
  translation: TranslationLike,
) {
  return (
    translation.title ||
    translation.name ||
    getTourValue(tour, [
      'title',
      'name',
    ]) ||
    tour.slug
  )
}

function getTourDuration(
  tour: TourLike,
  translation: TranslationLike,
) {
  return (
    translation.duration ||
    getTourValue(tour, [
      'duration',
      'durationText',
    ]) ||
    ''
  )
}

function getTourType(
  tour: TourLike,
  translation: TranslationLike,
  labels: (typeof contentByLocale)[Locale],
) {
  const type =
    translation.type ||
    getTourValue(tour, [
      'type',
      'category',
    ])

  if (
    typeof type === 'string' &&
    type.toLowerCase().includes('private')
  ) {
    return labels.private
  }

  if (
    typeof type === 'string' &&
    type.toLowerCase().includes('privat')
  ) {
    return labels.private
  }

  if (
    getTourValue(tour, [
      'private',
      'isPrivate',
    ]) === true
  ) {
    return labels.private
  }

  return labels.shared
}

function getTourHighlights(
  tour: TourLike,
  translation: TranslationLike,
) {
  const translatedHighlights =
    translation.highlights

  if (
    Array.isArray(translatedHighlights) &&
    translatedHighlights.length > 0
  ) {
    return translatedHighlights
  }

  const highlights = getTourValue(tour, [
    'highlights',
    'features',
    'includes',
  ])

  if (Array.isArray(highlights)) {
    return highlights.filter(Boolean)
  }

  return []
}

function getTranslation(
  slug: string,
  locale: Locale,
): TranslationLike {
  try {
    const translation = getTourTranslation(
      slug,
      locale,
    )

    if (translation) {
      return translation as TranslationLike
    }
  } catch {
    // Fallback below.
  }

  try {
    const translation = getTourTranslation(
      slug,
      defaultLocale,
    )

    if (translation) {
      return translation as TranslationLike
    }
  } catch {
    // Fallback below.
  }

  return {}
}

export function generateStaticParams() {
  return locales.flatMap((locale) =>
    allTours.map((tour) => ({
      locale,
      slug: tour.slug,
    })),
  )
}

export async function generateMetadata({
  params,
}: {
  params: Promise<PageParams>
}): Promise<Metadata> {
  const { locale: localeParam, slug } = await params

  const locale: Locale = isLocale(localeParam)
    ? localeParam
    : defaultLocale

  const tour = allTours.find(
    (item) => item.slug === slug,
  ) as TourLike | undefined

  if (!tour) {
    return {}
  }

  const translation = getTranslation(
    slug,
    locale,
  )

  const title = getTourTitle(
    tour,
    translation,
  )

  const description =
    getTourDescription(
      tour,
      translation,
    ).slice(0, 160)

  const path = getLocalizedPath(
    locale,
    `/passeios/${slug}/`,
  )

  const baseUrl =
    siteConfig.url ||
    siteConfig.siteUrl ||
    'https://vemvertur-rgb.github.io/vem-ver'

  const canonical = `${String(baseUrl).replace(
    /\/$/,
    '',
  )}${path}`

  return {
    title,
    description,
    alternates: {
      canonical,
      languages: Object.fromEntries(
        locales.map((item) => [
          localeHtmlLang[item],
          `${String(baseUrl).replace(
            /\/$/,
            '',
          )}${getLocalizedPath(
            item,
            `/passeios/${slug}/`,
          )}`,
        ]),
      ),
    },
    openGraph: {
      title,
      description,
      url: canonical,
      type: 'website',
    },
  }
}

